# Copy to .env and fill in. NEVER commit .env.
PRIVATE_KEY=0xyour_deployer_wallet_private_key

# Coin name, symbol and supply are set in token.config.js (RRoyal / RRx / 100,000,000).
# Uncomment only to override them:
# TOKEN_NAME=
# TOKEN_SYMBOL=
# TOKEN_SUPPLY=
# Optional: address that receives the supply (defaults to the deployer)
TOKEN_RECIPIENT=

# Optional overrides
CRONOS_RPC_URL=https://evm.cronos.org
CRONOS_TESTNET_RPC_URL=https://evm-t3.cronos.org

# Optional: enables automatic source verification on explorer.cronos.org
CRONOS_EXPLORER_API_KEY=
CRONOS_TESTNET_EXPLORER_API_KEY=
